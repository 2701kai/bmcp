# Bearer token(s) for /mcp, comma-separated. Unset = open server (local development only).
# Generate one with: openssl rand -hex 32
BMCP_TOKEN=

# Optional: deploy_status reads the Vercel API with this token, scoped to the BEVMAQ team.
VERCEL_TOKEN=
VERCEL_TEAM_ID=team_FUpeOeojMxNoP3zC6slDY3jU

